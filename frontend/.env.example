# Public site origin used for canonical URLs, OG images, feeds, and sitemaps.
NEXT_PUBLIC_SITE_URL=https://www.openmarketbd.com
VITE_SITE_URL=https://www.openmarketbd.com

# Existing Express API origin. Keep backend behavior intact.
BACKEND_API_URL=https://localhost:4000

# Internal automation security.
REVALIDATION_SECRET=change-me
WORKER_API_SECRET=change-me

# Redis starts as a single URL but the app uses an adapter for Sentinel/Cluster migration.
REDIS_URL=redis://localhost:6379
REDIS_MODE=single

# Object storage provider: local, s3, or r2.
STORAGE_PROVIDER=local
STORAGE_BUCKET=open-market-bd-media
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# Search provider: noop or typesense.
SEARCH_PROVIDER=noop
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# Monitoring.
SENTRY_DSN=
